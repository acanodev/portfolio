// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Technology {
  id         Int          @id @default(autoincrement())
  name       String
  category   CategoryType
  image_url  String?      @db.Text
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  projectTechnology ProjectTechnology[]
  experienceTechnology ExperienceTechnology[]

  @@map("technologies")
}

enum CategoryType {
  frontend
  backend
  cms
  databases
  devops_and_tools
  systems
  documentation_and_office
}

model Project {
  id             Int      @id @default(autoincrement())
  title          String
  description_en String?  @db.Text
  description_es String?  @db.Text
  thumbnail_url  String?  @db.Text
  github_url     String?
  demo_url       String?
  featured       Boolean  @default(false) // At this moment it will not be used
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  year Int?

  projectTechnology ProjectTechnology[]

  @@map("projects")
}

model ProjectTechnology {
  project_id    Int
  technology_id Int

  project    Project    @relation(fields: [project_id], references: [id])
  technology Technology @relation(fields: [technology_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@id([project_id, technology_id])
  @@map("project_technology")
}

// Traceability for frontend contact form sent messages.
model ContactMessage {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  subject String?
  message String  @db.Text

  created_at DateTime @default(now())

  @@map("contact_messages")
}

model SoftSkill {
  id        Int     @id @default(autoincrement())
  name_en   String
  name_es   String
  image_url String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("softskills")
}

model Experience {
  id Int @id @default(autoincrement())
  company_name  String
  job_title_en String
  job_title_es String
  description_en String?
  description_es String?
  year Int?
  start_year Int?
  end_year Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  experienceTechnology ExperienceTechnology[]

  @@map("experience")
}

model ExperienceTechnology {
  experience_id Int
  technology_id Int

  experience Experience @relation(fields: [experience_id], references: [id])
  technology Technology @relation(fields: [technology_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@id([experience_id, technology_id])
}